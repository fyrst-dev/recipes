# Copy to deploy/sync.env on each VPS (chmod 600). Never commit filled values.
# Sourced by deploy/sync-runtime.sh only — not by deploy/vps-release.sh.
# Object storage (S3 and similar) is out of scope for this VPS path.

# This environment's role. restore/sync refuse SYNC_ENV=live.
# Examples: staging | playground | dev | live
SYNC_ENV=staging

# Public URL of THIS shop (log reminder after restore; rewrite sales channels manually).
# SYNC_APP_URL=https://staging.example.com

# Optional non-fatal hook after restore (quote as you would in a shell).
# SYNC_POST_RESTORE_CMD=echo 'rewrite sales_channel_domain here'

# Snapshot work dir on this host (default: <shop>/var/runtime-sync).
# SYNC_SNAPSHOT_DIR=/var/tmp/shopware-runtime-sync

# --- SSH source (consumer only; omit on live if you never pull) ---------------
# --from live uses these unless SYNC_LIVE_SSH_* is set.

# Hostname, IP, or ~/.ssh/config Host
SYNC_SSH_HOST=
SYNC_SSH_USER=
SYNC_SSH_PORT=22
# Identity file (no passphrase for cron). Empty = ssh default identities.
SYNC_SSH_KEY=
# Shop checkout on the source (required for --from <alias>)
SYNC_REMOTE_PATH=/opt/shopware/live

# Optional per-alias overrides for --from live / --from playground
# SYNC_LIVE_SSH_HOST=
# SYNC_LIVE_SSH_USER=
# SYNC_LIVE_SSH_PORT=
# SYNC_LIVE_SSH_KEY=
# SYNC_LIVE_REMOTE_PATH=/opt/shopware/live

# Image used to tar named volumes (pulled on first use).
# SYNC_ARCHIVE_IMAGE=alpine:3.20
