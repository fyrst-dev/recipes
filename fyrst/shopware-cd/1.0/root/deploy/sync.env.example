# Copy to deploy/sync.env on each VPS (chmod 600). Never commit filled values.
# Sourced by deploy/sync-runtime.sh and optionally deploy/sync-runtime-local.sh
# — not by deploy/vps-release.sh. Sync is not a backup; live uses
# deploy/backup.env.example + deploy/backup-runtime.sh.
# Object storage (S3 and similar) is out of scope for this VPS path.
# Local project dev pull uses SYNC_SSH_* + SYNC_REMOTE_DATA_ROOT only; it does
# not restore the DB and does not write to SHOPWARE_DATA_ROOT / SYNC_DATA_ROOT.

# This environment's role. restore/sync refuse SYNC_ENV=live.
# Examples: staging | playground | dev | live
SYNC_ENV=staging

# Public URL of THIS shop (log reminder after restore when rewrite is off).
# SYNC_APP_URL=https://staging.example.com

# Opt-in post-restore rewrite of sales_channel_domain.url only (default: off).
# Hard-refused when SYNC_ENV / SHOPWARE_DEPLOY_ENV / checkout / hostname is live
# (SYNC_ALLOW_LIVE_RESTORE=1 does not bypass this).
# Origin replace, path kept. Does not touch media CDN, plugin configs, or webhooks.
# SYNC_REWRITE_APP_URL=https://staging.example.com
#
# Optional old=new prefix map (longest match first) when one host is not enough:
# SYNC_REWRITE_URL_MAP=https://shop.example.com=https://staging.example.com,https://b2b.example.com=https://b2b.staging.example.com

# Optional non-fatal hook after restore (quote as you would in a shell).
# Payment/shipping webhooks may still need manual review after a live pull.
# SYNC_POST_RESTORE_CMD=echo 'review payment/shipping webhook URLs'

# Snapshot work dir on this host (default: <shop>/var/runtime-sync).
# SYNC_SNAPSHOT_DIR=/var/tmp/shopware-runtime-sync

# Bind-mount root on THIS host. Unset → SHOPWARE_DATA_ROOT from shop-root .env,
# else derived: $SHOPWARE_DATA_BASE/$SHOPWARE_SHOP_ID/$SHOPWARE_DEPLOY_ENV
# (SHOPWARE_DATA_BASE default /var/lib/shopware/data). Compose uses that same
# formula from shop id + env (it does not read SHOPWARE_DATA_ROOT).
# SYNC_DATA_ROOT=/var/lib/shopware/data/acme/staging

# Bind-mount root on the SSH source. Unset → SYNC_<ALIAS>_DATA_ROOT, else the
# source shop .env SHOPWARE_DATA_ROOT, else
# $SHOPWARE_DATA_BASE/$SHOPWARE_SHOP_ID/$SYNC_SOURCE_ENV
# (SYNC_SOURCE_ENV default = --from alias, typically live).
# SYNC_REMOTE_DATA_ROOT=/var/lib/shopware/data/acme/live
#
# Last path component for derived remote roots when SYNC_REMOTE_DATA_ROOT is unset.
# SYNC_SOURCE_ENV=live

# --- SSH source (consumer only; omit on live if you never pull) ---------------
# --from live uses these unless SYNC_LIVE_SSH_* is set.

# Hostname, IP, or ~/.ssh/config Host
SYNC_SSH_HOST=
SYNC_SSH_USER=
SYNC_SSH_PORT=22
# Identity file (no passphrase for cron). Empty = ssh default identities.
SYNC_SSH_KEY=
# Shop checkout on the source (required for --from <alias>)
SYNC_REMOTE_PATH=/opt/shopware/live

# Optional per-alias overrides for --from live / --from playground
# SYNC_LIVE_SSH_HOST=
# SYNC_LIVE_SSH_USER=
# SYNC_LIVE_SSH_PORT=
# SYNC_LIVE_SSH_KEY=
# SYNC_LIVE_REMOTE_PATH=/opt/shopware/live
# SYNC_LIVE_DATA_ROOT=/var/lib/shopware/data/acme/live

# Image used to tar bind-mount dirs (or named-volume fallback) when rsync cannot write.
# SYNC_ARCHIVE_IMAGE=alpine:3.20
