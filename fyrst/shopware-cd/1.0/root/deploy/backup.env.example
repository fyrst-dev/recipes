# Copy to deploy/backup.env on each VPS that takes backups (chmod 600).
# Never commit filled values. Sourced by deploy/backup-runtime.sh — not by
# deploy/vps-release.sh or deploy/sync-runtime.sh.
#
# Sync (deploy/sync-runtime.sh) is live → staging/dev. It is NOT a backup.
# This file is the backup path. It MUST run on SHOPWARE_DEPLOY_ENV=live.
# Object storage (S3) and WAL/PITR are out of scope.

# Destination. Local path, second disk, or SSH.
# Examples:
#   BACKUP_TARGET=/var/backups/shopware
#   BACKUP_TARGET=/mnt/backup-disk/shopware
#   BACKUP_TARGET=backup@backup-host:/var/backups/shopware
#   BACKUP_TARGET=ssh://backup@backup-host:22/var/backups/shopware
BACKUP_TARGET=/var/backups/shopware

# Keep timestamped artifacts this many days (directory name YYYYMMDDTHHMMSSZ).
# 0 = never prune. Default 14.
BACKUP_KEEP_DAYS=14

# Optional SSH identity for user@host:/path targets (no passphrase for cron).
# BACKUP_SSH_KEY=/home/deploy/.ssh/id_backup
# BACKUP_SSH_PORT=22

# Disaster recovery onto live (do not set in cron). Quarterly drill: restore
# onto staging instead, without this flag.
# BACKUP_ALLOW_LIVE_RESTORE=0
# BACKUP_CONFIRM_RESTORE=0
